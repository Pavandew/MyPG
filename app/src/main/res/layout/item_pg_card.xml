<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    android:layout_margin="7dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/pg_card_image"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:scaleType="centerCrop"
                android:src="@drawable/room_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Heart -->
            <ImageView
                android:id="@+id/pg_card_fav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="6dp"
                style="filled"
                app:tint="#E91E63"
                android:padding="4dp"
                android:src="@drawable/ic_bookmarkheart_24dp"
                app:layout_constraintEnd_toEndOf="@id/pg_card_image"
                app:layout_constraintTop_toTopOf="@id/pg_card_image" />

        <!-- Rating Badge -->
        <LinearLayout
            android:id="@+id/pg_card_ratingLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_rating_badge"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@id/pg_card_image"
            app:layout_constraintTop_toTopOf="@id/pg_card_image">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                style="filled"
                android:src="@drawable/ic_star_24dp"
                app:tint="#FFEB3B" />

            <TextView
                android:id="@+id/pg_card_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.5"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/pg_card_Pg_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sai Girls PG"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1E2A3A"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/pg_card_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/home_tv_price"/>

        <TextView
            android:id="@+id/home_tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 4,500 /mo"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#2F67D8"
            app:layout_constraintTop_toTopOf="@id/pg_card_Pg_name"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/pg_card_tvOnlyFor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Only for Girls"
            android:textSize="15sp"
            android:textColor="#5F6C7B"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/pg_card_Pg_name"
            app:layout_constraintStart_toStartOf="@id/pg_card_Pg_name"/>

        <LinearLayout
            android:id="@+id/home_amenitiesRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/pg_card_tvOnlyFor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                android:id="@+id/home_chip_wifi"
                layout="@layout/item_small_chips"
                />
            <include
                android:id="@+id/home_chip_food"
                layout="@layout/item_small_chips"
                />
            <include
                android:id="@+id/home_chip_ac"
                layout="@layout/item_small_chips"
                />
<!--            <include-->
<!--                android:id="@+id/home_chip_laundry"-->
<!--                layout="@layout/item_small_chips"-->
<!--                />-->
        </LinearLayout>

        <!-- Location -->
        <ImageView
            android:id="@+id/home_ivPin"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_location_on_24dp"
            style="filled"
            app:tint="@color/black"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/home_amenitiesRow"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/pg_card_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Supela, Bhilai"
            android:textSize="18sp"
            android:textColor="#2D4B6B"
            android:layout_marginStart="6dp"
            app:layout_constraintTop_toTopOf="@id/home_ivPin"
            app:layout_constraintBottom_toBottomOf="@id/home_ivPin"
            app:layout_constraintStart_toEndOf="@id/home_ivPin"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/guest_view_details_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_gradient"
            android:text="View Detail"
            android:layout_marginTop="10dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pg_card_location" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
