<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_nav_graph"
    app:startDestination="@id/optionsFragment">

    <fragment
        android:id="@+id/optionsFragment"
        android:name="com.example.searchroom.authScreen.fragments.OptionsFragment"
        android:label="fragment_options"
        tools:layout="@layout/fragment_options" >
        <action
            android:id="@+id/action_optionsFragment_to_loginFragment"
            app:destination="@id/loginFragment" />

        <argument
            android:name="userType"
            app:argType="string"
            android:defaultValue="GUEST"/>
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.searchroom.authScreen.fragments.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />

        <argument
            android:name="userType"
            app:argType="string"
            android:defaultValue="GUEST"/>
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.searchroom.authScreen.fragments.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up" >

        <action
            android:id="@+id/action_signUpFragment_to_loginFragment"
            app:destination="@id/loginFragment" />


        <argument
            android:name="userType"
            app:argType="string"
            android:defaultValue="GUEST"/>
    </fragment>

</navigation>